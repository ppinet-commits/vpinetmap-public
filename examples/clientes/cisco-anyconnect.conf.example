# Configuración de ejemplo: Cisco AnyConnect / OpenConnect (SAML / Duo / Tradicional)
# Copiar este archivo a /etc/vpnhub/clientes/<nombre>.conf
ID=3
TYPE=anyconnect
SERVER="vpn.empresa.com"
PORT=443
TRUSTED_CERT="pin-sha256:..."
AUTHGROUP="DEFAULT"
MAP="10.203.0.0/24=10.1.0.0/24"
DIRECT=""
IGNORE="10.0.0.0/8"
AUTO_MAP="1"
CHECK_IP=""
HOSTS="app=10.1.0.50 db=10.1.0.60"
DNS_SERVER=""
DOMAINS=""
OTP_REQUIRED=0
DESCRIPTION="Acceso AnyConnect con Duo SSO Push"
OWNER=""
CREATED_BY="admin"
DISABLED=0
DISABLED_BY=""
DNS_ALIAS="anyconnect"
