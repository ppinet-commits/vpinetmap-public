# Configuración de ejemplo: L2TP/IPsec con PSK y MS-CHAPv2
# Copiar este archivo a /etc/vpnhub/clientes/<nombre>.conf
ID=6
TYPE=l2tp
SERVER="l2tp.ejemplo.com"
PORT=
TRUSTED_CERT=""
AUTHGROUP=""
MAP="10.206.0.0/24=192.168.0.0/24"
DIRECT=""
IGNORE=""
AUTO_MAP="1"
CHECK_IP="192.168.0.1"
HOSTS="router=192.168.0.1"
DNS_SERVER=""
DOMAINS=""
OTP_REQUIRED=0
DESCRIPTION="Túnel L2TP/IPsec"
OWNER=""
CREATED_BY="admin"
DISABLED=0
DISABLED_BY=""
DNS_ALIAS="l2tp"
