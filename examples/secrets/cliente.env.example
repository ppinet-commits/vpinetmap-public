# Secretos de autenticación para VPNs basadas en usuario y contraseña o clave precompartida (PSK)
# Ubicación en el servidor: /etc/vpnhub/secrets/<nombre>.env (permisos: root 600)

VPN_USER="mi_usuario_vpn"
VPN_PASS="mi_contraseña_secreta"
VPN_PSK="mi_clave_psk_precompartida"
VPN_KEYPASS="contraseña_clave_privada_opcional"
